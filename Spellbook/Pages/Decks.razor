@page "/"
@inject DeckStore Store
@inject NavigationManager Navigation

<h1>My decks</h1>
<p class="muted">Create and manage your decks. Changes stay in this browser.</p>
@if (!loaded) { <p>Loading decks…</p> }
else if (loadFailed)
{
    <p role="alert"><strong>Saved decks could not be loaded.</strong> @error No edits were saved.</p>
    @if (!string.IsNullOrEmpty(message)) { <p role="status">@message</p> }
    <p>Use Settings to download the raw data and restore a valid JSON backup.</p>
    <a href="/settings">Open Settings</a>
}
else
{
    <div class="toolbar">
        <label>New deck name <input aria-label="New deck name" maxlength="160" @bind="newName" /></label>
        <button @onclick="CreateDeck">Create deck</button>
    </div>
    @if (decks.Count == 0) { <p>No decks yet. Create your first one above.</p> }
    <section class="deck-grid" aria-label="Your decks">
        @foreach (var deck in decks)
        {
            <article class="deck-tile">
                <label>Deck name <input aria-label="Deck name for @deck.Name" maxlength="160" value="@deck.Name" @onchange="e => Rename(deck, e)" /></label>
                <p>@deck.CardCount cards · @deck.Format</p>
                <div class="deck-tile-actions" role="group" aria-label="Actions for @deck.Name">
                    <button class="icon-action" title="Open deck" aria-label="Open deck @deck.Name" @onclick="() => Edit(deck)"><span aria-hidden="true">↗</span></button>
                    <button class="icon-action danger" title="Delete deck" aria-label="Delete deck @deck.Name" @onclick="() => Delete(deck)"><span aria-hidden="true">×</span></button>
                </div>
            </article>
        }
    </section>
    @if (!string.IsNullOrEmpty(message)) { <p role="status">@message</p> }
}

@code {
    private List<Deck> decks = [];
    private string newName = "";
    private string message = "";
    private string? error;
    private bool loaded;
    private bool loadFailed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { decks = await Store.LoadAsync(); }
        catch (InvalidDataException ex) { error = ex.Message; loadFailed = true; }
        loaded = true;
        StateHasChanged();
    }
    private async Task CreateDeck()
    {
        if (string.IsNullOrWhiteSpace(newName) || newName.Trim().Length > 160) { message = "Deck name must be 1–160 characters."; return; }
        var deck = new Deck { Name = newName.Trim() };
        decks.Add(deck);
        try { await Store.SaveAsync(decks); Navigation.NavigateTo($"/deck/{deck.Id}"); }
        catch (JSException ex) { decks.Remove(deck); message = $"Could not save this deck: {ex.Message}"; }
    }
    private void Edit(Deck deck) => Navigation.NavigateTo($"/deck/{deck.Id}");
    private async Task Rename(Deck deck, ChangeEventArgs e)
    {
        var name = e.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(name) || name.Length > 160) { message = "Deck name must be 1–160 characters."; return; }
        var oldName = deck.Name;
        deck.Name = name;
        try { await Store.SaveAsync(decks); message = "Deck name saved."; }
        catch (JSException ex) { deck.Name = oldName; message = $"Could not rename this deck: {ex.Message}"; }
    }
    private async Task Delete(Deck deck)
    {
        decks.Remove(deck);
        try { await Store.SaveAsync(decks); }
        catch (JSException ex) { decks.Add(deck); message = $"Could not delete this deck: {ex.Message}"; }
    }
}
