@page "/"
@inject DeckStore Store
<h1>My decks</h1>
<p class="muted">Build, tune, and export decks. All changes are saved locally in this browser.</p>
<p role="note"><strong>Back up your decks:</strong> This browser storage does not sync to your other devices, and clearing Safari/browser data can erase it. Use <strong>Export JSON</strong> regularly and store the downloaded file somewhere safe.</p>
@if (!loaded) { <p>Loading decks…</p> }
else if (loadFailed)
{
    <p role="alert"><strong>Saved decks could not be loaded.</strong> @message No edits will be saved until the problem is resolved.</p>
    <p>You can download your raw saved data before restoring a valid backup. Recovery replaces the existing browser data, so keep the raw copy first.</p>
    <button @onclick="ExportDamaged">Download raw saved data</button>
    <label><input type="checkbox" @bind="confirmRecovery" /> I understand restoring a backup will replace the currently unreadable data.</label>
    <label class="upload">Restore JSON backup <InputFile OnChange="RecoverImport" accept=".json,application/json" disabled="@(!confirmRecovery)" /></label>
}
else
{
    <div class="toolbar">
        <input aria-label="New deck name" placeholder="New deck name" maxlength="160" @bind="newDeckName" />
        <button @onclick="AddDeck">Create deck</button>
        <button class="secondary" @onclick="Export">Export JSON</button>
        <label class="upload">Import JSON <InputFile OnChange="Import" accept=".json,application/json" /></label>
    </div>
    @if (!string.IsNullOrEmpty(message)) { <p role="status" class="note">@message</p> }
    <div class="columns">
        <section class="deck-list" aria-label="Decks">
            @foreach (var deck in decks)
            {
                <button class="deck-choice @(selected?.Id == deck.Id ? "active" : "")" @onclick="() => Select(deck)">
                    <strong>@deck.Name</strong><small>@deck.CardCount cards · @deck.Format</small>
                </button>
            }
            @if (decks.Count == 0) { <p>No decks yet. Create your first one above.</p> }
        </section>
        @if (selected is not null)
        {
            <section class="editor">
                <div class="editor-heading"><h2>@selected.Name</h2><button class="danger" @onclick="DeleteDeck">Delete deck</button></div>
                <label>Deck name<input maxlength="160" @bind="selected.Name" @bind:after="Persist" /></label>
                <label>Game format<select @bind="selected.Format" @bind:after="Persist"><option>Casual 60-card</option><option>Two-Headed Giant</option><option>Standard</option><option>Modern</option><option>Commander</option><option>Other</option></select></label>
                <h3>Add a card</h3>
                <div class="toolbar"><input aria-label="Card name" placeholder="Exact card name" @bind="cardName" @onkeydown="HandleEnter" /><input class="qty" type="number" min="1" max="250" aria-label="Quantity" @bind="quantity" /><button @onclick="AddCard">Add</button></div>
                <p class="muted">Use the printed card name. Card recognition and automatic lookup are coming later.</p>
                <h3>Deck · @selected.CardCount cards (all zones)</h3>
                <div class="card-rows">
                @foreach (var card in selected.Cards.OrderBy(c => c.Name).ToList())
                {
                    <div class="card-row"><span>@card.Name <small>@card.Section</small></span><div class="row-actions"><button aria-label="Decrease quantity for @CardLabel(card)" class="small" @onclick="() => ChangeQuantity(card, -1)">−</button><strong>@card.Quantity</strong><button aria-label="Increase quantity for @CardLabel(card)" class="small" @onclick="() => ChangeQuantity(card, 1)">+</button><button aria-label="Remove @CardLabel(card)" class="small danger" @onclick="() => RemoveCard(card)">×</button></div></div>
                }
                </div>
                <h3>iPhone photo / video intake</h3>
                <p>Choose images or videos from your iPhone. This prototype confirms the selected files; it does <strong>not</strong> upload or analyze them.</p>
                <InputFile OnChange="MediaSelected" accept="image/*,video/*" multiple />
                @if (mediaNames.Count > 0) { <p role="status">Selected: @string.Join(", ", mediaNames)</p> }
            </section>
        }
    </div>
    <Spellbook.Components.DeckListTransfer CurrentDeck="selected" OnImport="ImportDeckList" />
}
@code {
    private List<Deck> decks = [];
    private Deck? selected;
    private bool loaded;
    private bool loadFailed;
    private bool confirmRecovery;
    private string lastSavedName = "";
    private string newDeckName = "";
    private string cardName = "";
    private int quantity = 1;
    private string message = "";
    private List<string> mediaNames = [];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            decks = await Store.LoadAsync();
            selected = decks.FirstOrDefault();
            lastSavedName = selected?.Name ?? "";
        }
        catch (InvalidDataException ex)
        {
            loadFailed = true;
            message = ex.Message;
        }
        finally
        {
            loaded = true;
            StateHasChanged();
        }
    }
    private async Task AddDeck()
    {
        if (string.IsNullOrWhiteSpace(newDeckName) || newDeckName.Trim().Length > 160)
        {
            message = "Deck name must be 1–160 characters.";
            return;
        }
        var deck = new Deck { Name = newDeckName.Trim() };
        decks.Add(deck); selected = deck; lastSavedName = deck.Name; newDeckName = "";
        await Persist();
    }
    private void Select(Deck deck) { selected = deck; lastSavedName = deck.Name; mediaNames.Clear(); message = ""; }
    private async Task DeleteDeck()
    {
        if (selected is null) return;
        decks.Remove(selected); selected = decks.FirstOrDefault(); lastSavedName = selected?.Name ?? "";
        await Persist();
    }
    private async Task AddCard()
    {
        if (selected is null || string.IsNullOrWhiteSpace(cardName) || quantity < 1 || quantity > 250) return;
        var existing = selected.Cards.FirstOrDefault(c => string.Equals(c.Section.Trim(), "Main", StringComparison.OrdinalIgnoreCase) && string.Equals(c.Name, cardName.Trim(), StringComparison.OrdinalIgnoreCase));
        if (existing is not null) existing.Quantity = Math.Min(250, existing.Quantity + quantity);
        else selected.Cards.Add(new DeckCard { Name = cardName.Trim(), Quantity = quantity });
        cardName = ""; quantity = 1; await Persist();
    }
    private Task HandleEnter(KeyboardEventArgs e) => e.Key == "Enter" ? AddCard() : Task.CompletedTask;
    private async Task ChangeQuantity(DeckCard card, int delta)
    {
        if (selected is null) return;
        card.Quantity += delta;
        if (card.Quantity <= 0) selected.Cards.Remove(card);
        else card.Quantity = Math.Min(250, card.Quantity);
        await Persist();
    }
    private async Task RemoveCard(DeckCard card) { selected?.Cards.Remove(card); await Persist(); }
    private async Task Persist()
    {
        if (loadFailed) return;
        if (selected is not null)
        {
            if (string.IsNullOrWhiteSpace(selected.Name) || selected.Name.Trim().Length > 160)
            {
                selected.Name = lastSavedName;
                message = "Deck name must be 1–160 characters. The previous name was restored.";
                return;
            }
            selected.Name = selected.Name.Trim();
            selected.UpdatedUtc = DateTimeOffset.UtcNow;
        }
        await Store.SaveAsync(decks);
        lastSavedName = selected?.Name ?? "";
    }
    private static string CardLabel(DeckCard card) => card.Section == "Main" ? card.Name : $"{card.Name} ({card.Section})";
    private async Task ImportDeckList(Deck deck)
    {
        decks.Add(deck); selected = deck; lastSavedName = deck.Name;
        await Persist();
    }
    private Task ExportDamaged() => Store.ExportDamagedAsync();
    private async Task RecoverImport(InputFileChangeEventArgs e)
    {
        if (!loadFailed || !confirmRecovery) return;
        try
        {
            var file = e.File;
            if (file.Size > 2_000_000) throw new InvalidDataException("Backup must be smaller than 2 MB.");
            using var stream = file.OpenReadStream(2_000_000);
            using var reader = new StreamReader(stream);
            var recovered = Store.ParseImport(await reader.ReadToEndAsync());
            await Store.SaveAsync(recovered);
            decks = recovered;
            selected = decks.FirstOrDefault();
            lastSavedName = selected?.Name ?? "";
            loadFailed = false;
            confirmRecovery = false;
            message = $"Restored {recovered.Count} deck(s).";
        }
        catch (Exception ex) when (ex is InvalidDataException or JsonException or IOException or Microsoft.JSInterop.JSException)
        {
            message = $"Recovery failed; original saved data was not intentionally replaced: {ex.Message}";
        }
    }
    private Task Export() => Store.ExportAsync(decks);
    private async Task Import(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file.Size > 2_000_000) throw new InvalidDataException("Import must be smaller than 2 MB.");
            using var stream = file.OpenReadStream(2_000_000);
            using var reader = new StreamReader(stream);
            var imported = Store.ParseImport(await reader.ReadToEndAsync());
            foreach (var d in imported) d.Id = Guid.NewGuid();
            decks.AddRange(imported); selected = imported.FirstOrDefault() ?? selected; lastSavedName = selected?.Name ?? "";
            await Persist(); message = $"Imported {imported.Count} deck(s).";
        }
        catch (Exception ex) when (ex is InvalidDataException or JsonException or IOException) { message = $"Import failed: {ex.Message}"; }
    }
    private void MediaSelected(InputFileChangeEventArgs e)
    {
        mediaNames = e.GetMultipleFiles(25).Select(f => f.Name).ToList();
    }
}
