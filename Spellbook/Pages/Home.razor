@page "/deck/{DeckId:guid}"
@inject DeckStore Store
@inject IJSRuntime JS
@inject NavigationManager Navigation
<h1>@(selected?.Name ?? "Edit deck")</h1>
<p class="muted">Edit one deck. Changes are saved locally in this browser.</p>
<p><a href="/">← All decks</a></p>
@if (!loaded) { <p>Loading decks…</p> }
else if (loadFailed)
{
    <p role="alert"><strong>Saved decks could not be loaded.</strong> @message No edits will be saved until the problem is resolved.</p>
    <p>You can download your raw saved data before restoring a valid backup. Recovery replaces the existing browser data, so keep the raw copy first.</p>
    <button @onclick="ExportDamaged">Download raw saved data</button>
    <label><input type="checkbox" @bind="confirmRecovery" /> I understand restoring a backup will replace the currently unreadable data.</label>
    <label class="upload">Restore JSON backup <InputFile OnChange="RecoverImport" accept=".json,application/json" disabled="@(!confirmRecovery)" /></label>
}
else if (selected is not null)
{
    @if (!string.IsNullOrEmpty(message)) { <p role="status" class="note">@message</p> }
            <section class="editor">
                <div class="editor-heading"><h2>@selected.Name</h2><button class="icon-action danger" title="Delete deck" aria-label="Delete deck" @onclick="RequestDeleteDeck"><span aria-hidden="true">×</span></button></div>
                @if (confirmDeleteDeck)
                {
                    <div class="delete-confirmation" role="group" aria-label="Confirm deck deletion">
                        <p>Delete this deck permanently? This cannot be undone.</p>
                        <button class="danger" @onclick="DeleteDeck">Confirm delete</button>
                        <button class="secondary" @onclick="CancelDeleteDeck">Cancel</button>
                    </div>
                }
                <label>Deck name<input maxlength="160" @bind="selected.Name" @bind:after="Persist" /></label>
                <label>Game format<select @bind="selected.Format" @bind:after="Persist"><option>Casual 60-card</option><option>Two-Headed Giant</option><option>Standard</option><option>Modern</option><option>Commander</option><option>Other</option></select></label>
                <h3>Add a card</h3>
                <div class="toolbar"><input aria-label="Card name" placeholder="Search Magic cards" role="combobox" aria-autocomplete="list" aria-expanded="@(suggestions.Count > 0 ? "true" : "false")" aria-controls="card-suggestions" aria-activedescendant="@(activeSuggestionIndex >= 0 && activeSuggestionIndex < suggestions.Count ? $"card-suggestion-{activeSuggestionIndex}" : null)" @bind="cardName" @oninput="CardTyping" @onkeydown="HandleCardKeyDown" autocomplete="off" /><input class="qty" type="number" min="1" max="250" aria-label="Quantity" @bind="quantity" /><button @onclick="AddCard">Add</button></div>
                @if (suggestions.Count > 0)
                {
                    <div id="card-suggestions" class="card-suggestions" role="listbox" aria-label="Card suggestions">
                        @for (var i = 0; i < suggestions.Count; i++)
                        {
                            var suggestion = suggestions[i];
                            <button id="card-suggestion-@i" class="card-suggestion" role="option" aria-selected="@(i == activeSuggestionIndex ? "true" : "false")" @onclick="() => ChooseSuggestion(suggestion)">@suggestion.Name</button>
                        }
                    </div>
                }
                @if (!string.IsNullOrEmpty(searchMessage)) { <p class="muted" role="status">@searchMessage</p> }
                <p class="muted">Suggestions powered by <a href="https://scryfall.com" target="_blank" rel="noopener noreferrer">Scryfall</a>. Typing sends only your search text to Scryfall. Manual entry works offline.</p>
                <h3>Deck · @selected.CardCount cards (all zones)</h3>
                <div class="card-display-controls" role="group" aria-label="Deck card display mode">
                    <button class="secondary" aria-pressed="@(!visualMode)" @onclick="() => visualMode = false">List</button>
                    <button class="secondary" aria-pressed="@visualMode" @onclick="() => visualMode = true">Visual</button>
                </div>
                <div class="card-rows @(visualMode ? "visual-mode" : "list-mode")" aria-label="Cards in @selected.Name">
                @foreach (var card in selected.Cards.OrderBy(c => c.Name).ToList())
                {
                    <article class="card-row @(visualMode ? "visual-card" : "list-card")">
                        @if (visualMode)
                        {
                            @if (IsScryfallImageUrl(card.Details?.ImageUrl))
                            {
                                <img class="visual-card-art" alt="Card image for @card.Name" loading="lazy" referrerpolicy="no-referrer" src="@card.Details!.ImageUrl" />
                            }
                            else
                            {
                                <div class="visual-card-art visual-card-fallback" aria-hidden="true">✦</div>
                            }
                        }
                        <div class="visual-card-info">
                            @if (editingCard == card)
                            {
                                <label class="muted">New card name
                                    <input aria-label="New card name for @CardLabel(card)" maxlength="200" @bind="editCardName" @bind:event="oninput" disabled="@renameBusy" />
                                </label>
                                <div class="row-actions">
                                    <button class="small" aria-label="Save card name for @CardLabel(card)" @onclick="() => SaveCardName(card)" disabled="@renameBusy">@(renameBusy ? "Checking…" : "Save")</button>
                                    <button class="small secondary" aria-label="Cancel card name edit for @CardLabel(card)" @onclick="CancelCardNameEdit" disabled="@renameBusy">Cancel</button>
                                </div>
                                <p class="muted">Name edits are verified against Scryfall; manually added names can remain unverified.</p>
                            }
                            else
                            {
                                <div class="card-title-display">
                                    <a href="@ScryfallCardSearchUrl(card.Name)" target="_blank" rel="noopener noreferrer" aria-label="Find @CardLabel(card) on Scryfall">@card.Name</a>
                                    <button class="icon-action" title="Edit card name" aria-label="Edit card name for @CardLabel(card)" @onclick="() => StartCardNameEdit(card)"><span aria-hidden="true">✎</span></button>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(card.Details?.ManaCost))
                            {
                                <span class="mana-cost" aria-label="Mana cost @card.Details.ManaCost">
                                    @foreach (var symbol in ParseManaSymbols(card.Details.ManaCost))
                                    {
                                        <span class="mana-symbol @ManaSymbolClass(symbol)" title="@symbol" aria-hidden="true">@ManaSymbolText(symbol)</span>
                                    }
                                </span>
                            }
                            <small>@card.Section</small>
                        </div>
                        <div class="row-actions card-quantity-actions">
                            <button aria-label="Decrease quantity for @CardLabel(card)" class="small" @onclick="() => ChangeQuantity(card, -1)">−</button>
                            <strong aria-label="Quantity">@card.Quantity</strong>
                            <button aria-label="Increase quantity for @CardLabel(card)" class="small" @onclick="() => ChangeQuantity(card, 1)">+</button>
                            <button aria-label="Remove @CardLabel(card)" title="Remove card" class="icon-action danger" @onclick="() => RemoveCard(card)"><span aria-hidden="true">×</span></button>
                        </div>
                    </article>
                }
                </div>
                <Spellbook.Components.DeckStatistics Deck="selected" OnChanged="Persist" />
                <section class="card-scan-panel" aria-label="Scan a card">
                    <h3>Scan a card from a photo or video</h3>
                    <p>Choose a photo, an iPhone HEIC image, or a video. Scan a video locally to find cards across sampled frames, or scrub and capture one frame. Video OCR and stack-edge estimates run on this device; media is not uploaded. For better estimates, keep visible stack edges in focus; no fixed camera angle is required. Estimates are low-confidence and editable.</p>
                    <InputFile id="card-media-picker" OnChange="MediaSelected" accept="image/*,.heic,.heif,video/*" multiple />
                    @if (!string.IsNullOrEmpty(videoUrl))
                    {
                        <div class="video-frame-review">
                            <video id="card-video-preview" src="@videoUrl" controls playsinline preload="metadata" aria-label="Selected video: scrub to the frame showing the card"></video>
                            @if (!videoScanActive)
                            {
                                <button @onclick="ScanVideo" disabled="@mediaBusy">Scan video for cards</button>
                            }
                            else
                            {
                                <p role="status">Scanning local frames: @videoScanProgress of @videoScanTotal. @videoScanMessage</p>
                                <button class="secondary" @onclick="CancelVideoScan">Cancel video scan</button>
                            }
                            <button @onclick="CaptureVideoFrame" disabled="@mediaBusy">Capture selected video frame</button>
                            <p class="muted">Automatic scanning samples up to 100 frames across the clip. Longer clips are sampled more sparsely. Check and correct each stack estimate before adding.</p>
                            @if (!videoScanActive && !string.IsNullOrEmpty(videoScanMessage)) { <p role="status">@videoScanMessage</p> }
                        </div>
                    }
                    @if (videoCandidates.Count > 0)
                    {
                        <section class="video-scan-review" aria-label="Video card scan review">
                            <h4>Review cards found in video</h4>
                            <p>Repeated sightings in nearby frames are combined. Any detected stack quantity is a low-confidence estimate from visible edges; correct it before adding.</p>
                            @foreach (var candidate in videoCandidates)
                            {
                                <div class="video-candidate">
                                    <label>Card name<input maxlength="200" @bind="candidate.Name" /></label>
                                    <label>Quantity<input type="number" min="1" max="250" @bind="candidate.Quantity" /></label>
                                    <small>@candidate.EstimateLabel</small>
                                </div>
                            }
                            <button @onclick="AddVideoCandidates" disabled="@mediaBusy">Add reviewed cards</button>
                        </section>
                    }
                    @if (mediaNames.Count > 0) { <p role="status">Selected: @string.Join(", ", mediaNames)</p> }
                    @if (!string.IsNullOrEmpty(mediaMessage)) { <p role="status" class="note">@mediaMessage</p> }
                    @if (!string.IsNullOrEmpty(previewDataUrl))
                    {
                        <div class="scan-review">
                            <img class="scan-preview" alt="Selected local card photo for review" src="@previewDataUrl" />
                            <div class="scan-actions">
                                <button @onclick="ReadPhoto" disabled="@mediaBusy">@(mediaBusy ? "Reading photo…" : "Recognize text on device")</button>
                                <button class="secondary" @onclick="ClearScan" disabled="@mediaBusy">Clear photo</button>
                                <label>Card name (confirm or correct)
                                    <input aria-label="Name from photo" maxlength="200" @bind="candidateName" @oninput="InvalidateScanVerification" disabled="@mediaBusy" />
                                </label>
                                <button class="secondary" @onclick="VerifyScannedCard" disabled="@mediaBusy">Verify against Scryfall</button>
                                @if (!string.IsNullOrEmpty(verificationMessage)) { <p role="status" class="muted">@verificationMessage</p> }
                                @if (verifiedScan is not null)
                                {
                                    <div class="verified-card">
                                        @if (!string.IsNullOrEmpty(verifiedScan.ImageUrl))
                                        {
                                            <img alt="Scryfall image of @verifiedScan.Name" loading="lazy" src="@verifiedScan.ImageUrl" />
                                        }
                                        <div><strong>@verifiedScan.Name</strong><p>@verifiedScan.TypeLine · mana value @verifiedScan.ManaValue</p>
                                            @if (IsScryfallLink(verifiedScan.ScryfallUrl))
                                            {
                                                <a href="@verifiedScan.ScryfallUrl" target="_blank" rel="noopener noreferrer">View card on Scryfall ↗</a>
                                            }
                                        </div>
                                    </div>
                                }
                                <button @onclick="ConfirmScannedCard" disabled="@mediaBusy">Add confirmed card</button>
                                @if (!string.IsNullOrWhiteSpace(recognizedText))
                                {
                                    <details><summary>Review extracted text</summary><pre class="scan-text">@recognizedText</pre></details>
                                }
                            </div>
                        </div>
                    }
                    </section>
            </section>
}
else
{
    <p role="alert">This deck could not be found.</p><a href="/">Return to all decks</a>
}
@code {
    [Parameter] public Guid DeckId { get; set; }
    private static string ScryfallCardSearchUrl(string name) =>
        "https://scryfall.com/search?q=" + Uri.EscapeDataString("!" + "\"" + name + "\"");
    private static bool IsScryfallLink(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
        uri.Scheme == Uri.UriSchemeHttps &&
        uri.Host.Equals("scryfall.com", StringComparison.OrdinalIgnoreCase);
    private List<Deck> decks = [];
    private Deck? selected;
    private bool loaded;
    private bool loadFailed;
    private bool confirmRecovery;
    private string lastSavedName = "";
    private string cardName = "";
    private List<ScryfallCard> suggestions = [];
    private int activeSuggestionIndex = -1;
    private string searchMessage = "";
    private int searchGeneration;
    private ScryfallCard? verifiedScan;
    private string verificationMessage = "";
    private string? lastVerifiedName;
    private int quantity = 1;
    private string message = "";
    private List<string> mediaNames = [];
    private string? previewDataUrl;
    private string? videoUrl;
    private string candidateName = "";
    private string recognizedText = "";
    private string mediaMessage = "";
    private bool mediaBusy;
    private int scanGeneration;
    private Guid? selectedDeckId;
    private bool videoScanActive;
    private int videoScanProgress;
    private int videoScanTotal;
    private string videoScanMessage = "";
    private List<VideoCardCandidate> videoCandidates = [];
    private ScryfallCard? selectedCardMetadata;
    private bool visualMode = true;
    private DeckCard? editingCard;
    private string editCardName = "";
    private bool renameBusy;
    private bool confirmDeleteDeck;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            decks = await Store.LoadAsync();
            selected = DeckId == Guid.Empty ? decks.FirstOrDefault() : decks.FirstOrDefault(d => d.Id == DeckId);
            selectedDeckId = selected?.Id;
            lastSavedName = selected?.Name ?? "";
        }
        catch (InvalidDataException ex)
        {
            loadFailed = true;
            message = ex.Message;
        }
        finally
        {
            loaded = true;
            StateHasChanged();
        }
    }
    protected override void OnParametersSet()
    {
        if (!loaded || selectedDeckId == DeckId) return;
        selected = decks.FirstOrDefault(d => d.Id == DeckId);
        selectedDeckId = selected?.Id;
        lastSavedName = selected?.Name ?? "";
    }
    private void RequestDeleteDeck() => confirmDeleteDeck = true;
    private void CancelDeleteDeck() => confirmDeleteDeck = false;
    private async Task DeleteDeck()
    {
        if (selected is null || !confirmDeleteDeck) return;
        confirmDeleteDeck = false;
        ClearScan();
        decks.Remove(selected); selected = null; lastSavedName = "";
        await Persist();
        Navigation.NavigateTo("/");
    }
    private async Task CardTyping(ChangeEventArgs e)
    {
        cardName = e.Value?.ToString() ?? "";
        var generation = ++searchGeneration;
        suggestions.Clear();
        activeSuggestionIndex = -1;
        selectedCardMetadata = null;
        searchMessage = "";
        if (cardName.Trim().Length < 2) return;
        try
        {
            await Task.Delay(350);
            if (generation != searchGeneration) return;
            var result = await JS.InvokeAsync<ScryfallCard[]>("spellbookScryfall.autocomplete", cardName.Trim());
            if (generation != searchGeneration) return;
            suggestions = (result ?? []).Take(10).Where(card => !string.IsNullOrWhiteSpace(card.Name)).ToList();
            activeSuggestionIndex = suggestions.Count > 0 ? 0 : -1;
            searchMessage = suggestions.Count == 0 ? "No suggestions. You can still add the name manually." : "";
        }
        catch (JSException)
        {
            if (generation != searchGeneration) return;
            searchMessage = "Scryfall is unavailable. You can enter the card manually.";
        }
        finally
        {
            if (generation == searchGeneration) await InvokeAsync(StateHasChanged);
        }
    }

    private void ChooseSuggestion(ScryfallCard suggestion)
    {
        cardName = suggestion.Name;
        selectedCardMetadata = suggestion;
        suggestions.Clear();
        activeSuggestionIndex = -1;
        searchGeneration++;
        searchMessage = "";
    }

    private void InvalidateScanVerification(ChangeEventArgs _) => ClearVerificationState();

    private void ClearVerificationState()
    {
        verifiedScan = null;
        lastVerifiedName = null;
        verificationMessage = "";
    }

    private async Task VerifyScannedCard()
    {
        verifiedScan = null;
        lastVerifiedName = null;
        verificationMessage = "";
        if (mediaBusy || previewDataUrl is null || string.IsNullOrWhiteSpace(candidateName)) return;
        var lookupName = candidateName.Trim();
        var generation = scanGeneration;
        try
        {
            var result = await JS.InvokeAsync<ScryfallCard?>("spellbookScryfall.exact", lookupName);
            if (generation != scanGeneration || !string.Equals(lookupName, candidateName.Trim(), StringComparison.Ordinal)) return;
            verifiedScan = result;
            lastVerifiedName = result is null ? null : lookupName;
            verificationMessage = result is null
                ? "No exact Scryfall match. Correct the name or add it manually."
                : "Found on Scryfall. Compare the card image and confirm before adding.";
        }
        catch (JSException)
        {
            if (generation != scanGeneration) return;
            verificationMessage = "Card lookup unavailable. You may still add the name manually.";
        }
    }

    private async Task AddCard()
    {
        if (selected is null || string.IsNullOrWhiteSpace(cardName) || quantity < 1 || quantity > 250) return;
        var existing = selected.Cards.FirstOrDefault(c => string.Equals(c.Section.Trim(), "Main", StringComparison.OrdinalIgnoreCase) && string.Equals(c.Name, cardName.Trim(), StringComparison.OrdinalIgnoreCase));
        if (existing is not null)
        {
            existing.Quantity = Math.Min(250, existing.Quantity + quantity);
            if (selectedCardMetadata is not null && string.Equals(selectedCardMetadata.Name, cardName.Trim(), StringComparison.OrdinalIgnoreCase))
                existing.Details = MergeScryfallDetails(existing.Details, selectedCardMetadata);
        }
        else
        {
            var card = new DeckCard { Name = cardName.Trim(), Quantity = quantity };
            if (selectedCardMetadata is not null && string.Equals(selectedCardMetadata.Name, cardName.Trim(), StringComparison.OrdinalIgnoreCase))
                card.Details = MergeScryfallDetails(null, selectedCardMetadata);
            selected.Cards.Add(card);
        }
        cardName = ""; quantity = 1; suggestions.Clear(); activeSuggestionIndex = -1; searchGeneration++; await Persist();
        selectedCardMetadata = null;
    }
    private async Task HandleCardKeyDown(KeyboardEventArgs e)
    {
        if (suggestions.Count == 0)
        {
            if (e.Key == "Enter") await AddCard();
            return;
        }

        if (e.Key == "ArrowDown")
        {
            activeSuggestionIndex = Math.Min(suggestions.Count - 1, activeSuggestionIndex + 1);
            await JS.InvokeVoidAsync("spellbookScryfall.scrollSuggestionIntoView", activeSuggestionIndex);
        }
        else if (e.Key == "ArrowUp")
        {
            activeSuggestionIndex = Math.Max(0, activeSuggestionIndex - 1);
            await JS.InvokeVoidAsync("spellbookScryfall.scrollSuggestionIntoView", activeSuggestionIndex);
        }
        else if (e.Key == "Enter" && activeSuggestionIndex >= 0)
        {
            ChooseSuggestion(suggestions[activeSuggestionIndex]);
        }
        else if (e.Key == "Escape")
        {
            suggestions.Clear();
            activeSuggestionIndex = -1;
            searchGeneration++;
        }
    }
    private async Task ChangeQuantity(DeckCard card, int delta)
    {
        if (selected is null) return;
        card.Quantity += delta;
        if (card.Quantity <= 0) selected.Cards.Remove(card);
        else card.Quantity = Math.Min(250, card.Quantity);
        await Persist();
    }
    private async Task RemoveCard(DeckCard card) { selected?.Cards.Remove(card); await Persist(); }
    private void StartCardNameEdit(DeckCard card)
    {
        editingCard = card;
        editCardName = card.Name;
        message = "";
    }

    private void CancelCardNameEdit()
    {
        editingCard = null;
        editCardName = "";
    }

    private async Task SaveCardName(DeckCard card)
    {
        if (selected is null || renameBusy || editingCard != card) return;
        var name = editCardName.Trim();
        if (string.IsNullOrWhiteSpace(name) || name.Length > 200 || name.Any(char.IsControl))
        {
            message = "Enter a card name with 1–200 characters and no control characters.";
            return;
        }
        if (string.Equals(name, card.Name, StringComparison.OrdinalIgnoreCase))
        {
            CancelCardNameEdit();
            return;
        }
        if (selected.Cards.Any(other => other != card &&
            string.Equals(other.Section.Trim(), card.Section.Trim(), StringComparison.OrdinalIgnoreCase) &&
            string.Equals(other.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)))
        {
            message = "A card with that name already exists in this section. Adjust its quantity instead.";
            return;
        }

        renameBusy = true;
        try
        {
            var verified = await JS.InvokeAsync<ScryfallCard?>("spellbookScryfall.exact", name);
            if (verified is null)
            {
                message = "No exact Scryfall card match. The saved name was not changed.";
                return;
            }
            card.Name = verified.Name;
            card.Details = MergeScryfallDetails(card.Details, verified);
            await Persist();
            editingCard = null;
            editCardName = "";
            message = "Card name verified and saved.";
        }
        catch (JSException)
        {
            message = "Scryfall could not verify this name. The saved name was not changed; try again when lookup is available.";
        }
        finally { renameBusy = false; }
    }

    private static CardDetails MergeScryfallDetails(CardDetails? existing, ScryfallCard result)
    {
        var details = existing ?? new CardDetails();
        details.ManaValue = result.ManaValue;
        details.TypeLine = result.TypeLine;
        details.ManaCost = result.ManaCost;
        details.ImageUrl = IsScryfallImageUrl(result.ImageUrl) ? result.ImageUrl : null;
        if (result.Colors.Length > 0) details.Colors = string.Concat(result.Colors);
        return details;
    }

    private static bool IsScryfallImageUrl(string? url) =>
        Uri.TryCreate(url, UriKind.Absolute, out var uri) &&
        uri.Scheme == Uri.UriSchemeHttps &&
        uri.Host.Equals("cards.scryfall.io", StringComparison.OrdinalIgnoreCase);

    private static IEnumerable<string> ParseManaSymbols(string manaCost) =>
        System.Text.RegularExpressions.Regex.Matches(manaCost, @"\{([^{}]{1,12})\}")
            .Cast<System.Text.RegularExpressions.Match>()
            .Select(match => match.Groups[1].Value)
            .Take(16);

    private static string ManaSymbolClass(string symbol) =>
        symbol.Contains("W", StringComparison.OrdinalIgnoreCase) ? "mana-white" :
        symbol.Contains("U", StringComparison.OrdinalIgnoreCase) ? "mana-blue" :
        symbol.Contains("B", StringComparison.OrdinalIgnoreCase) ? "mana-black" :
        symbol.Contains("R", StringComparison.OrdinalIgnoreCase) ? "mana-red" :
        symbol.Contains("G", StringComparison.OrdinalIgnoreCase) ? "mana-green" : "mana-generic";

    private static string ManaSymbolText(string symbol) => symbol.Length > 5 ? "…" : symbol;
    private async Task Persist()
    {
        if (loadFailed) return;
        if (selected is not null)
        {
            if (string.IsNullOrWhiteSpace(selected.Name) || selected.Name.Trim().Length > 160)
            {
                selected.Name = lastSavedName;
                message = "Deck name must be 1–160 characters. The previous name was restored.";
                return;
            }
            selected.Name = selected.Name.Trim();
            selected.UpdatedUtc = DateTimeOffset.UtcNow;
        }
        await Store.SaveAsync(decks);
        lastSavedName = selected?.Name ?? "";
    }
    private static string CardLabel(DeckCard card) => card.Section == "Main" ? card.Name : $"{card.Name} ({card.Section})";
    private Task ExportDamaged() => Store.ExportDamagedAsync();
    private async Task RecoverImport(InputFileChangeEventArgs e)
    {
        if (!loadFailed || !confirmRecovery) return;
        try
        {
            var file = e.File;
            if (file.Size > 2_000_000) throw new InvalidDataException("Backup must be smaller than 2 MB.");
            using var stream = file.OpenReadStream(2_000_000);
            using var reader = new StreamReader(stream);
            var recovered = Store.ParseImport(await reader.ReadToEndAsync());
            await Store.SaveAsync(recovered);
            ClearScan();
            decks = recovered;
            selected = decks.FirstOrDefault();
            lastSavedName = selected?.Name ?? "";
            loadFailed = false;
            confirmRecovery = false;
            message = $"Restored {recovered.Count} deck(s).";
        }
        catch (Exception ex) when (ex is InvalidDataException or JsonException or IOException or Microsoft.JSInterop.JSException)
        {
            message = $"Recovery failed; original saved data was not intentionally replaced: {ex.Message}";
        }
    }
    private async Task MediaSelected(InputFileChangeEventArgs e)
    {
        ClearScan();
        var generation = scanGeneration;
        var files = e.GetMultipleFiles(25);
        mediaNames = files.Select(f => f.Name).ToList();
        if (files.Count == 0) return;
        var image = files.FirstOrDefault(f => f.ContentType is "image/jpeg" or "image/png" or "image/webp");
        var heic = files.FirstOrDefault(f => f.ContentType is "image/heic" or "image/heif" ||
            f.Name.EndsWith(".heic", StringComparison.OrdinalIgnoreCase) ||
            f.Name.EndsWith(".heif", StringComparison.OrdinalIgnoreCase));
        var video = files.FirstOrDefault(f => f.ContentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase) ||
            f.Name.EndsWith(".mov", StringComparison.OrdinalIgnoreCase) ||
            f.Name.EndsWith(".mp4", StringComparison.OrdinalIgnoreCase) ||
            f.Name.EndsWith(".m4v", StringComparison.OrdinalIgnoreCase));
        if (image is null && heic is null && video is null)
        {
            mediaMessage = "Select a JPEG, PNG, WebP, HEIC/HEIF photo, or supported video.";
            return;
        }
        if (image is not null && image.Size > 6_000_000)
        {
            mediaMessage = "Photo exceeds 6 MB. Choose a smaller JPEG, PNG, or WebP image.";
            return;
        }
        if (image is null && heic is not null && heic.Size > 20_000_000)
        {
            mediaMessage = "HEIC exceeds the 20 MB limit.";
            return;
        }
        if (image is null && heic is null && video is not null && video.Size > 250_000_000)
        {
            mediaMessage = "Video exceeds the 250 MB limit.";
            return;
        }
        try
        {
            if (image is not null)
            {
                using var stream = image.OpenReadStream(6_000_000);
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                if (generation != scanGeneration) return;
                previewDataUrl = $"data:{image.ContentType};base64,{Convert.ToBase64String(buffer.ToArray())}";
            }
            else if (heic is not null)
            {
                var converted = await JS.InvokeAsync<string>("spellbookMedia.convertHeic", "card-media-picker");
                if (generation != scanGeneration) return;
                if (!converted.StartsWith("data:image/jpeg;base64,", StringComparison.Ordinal))
                    throw new InvalidDataException("HEIC conversion did not return a JPEG preview.");
                previewDataUrl = converted;
            }
            else
            {
                var prepared = await JS.InvokeAsync<string>("spellbookMedia.prepareVideo", "card-media-picker");
                if (generation != scanGeneration) return;
                if (!prepared.StartsWith("blob:", StringComparison.Ordinal))
                    throw new InvalidDataException("Video preview is unavailable.");
                videoUrl = prepared;
                mediaMessage = "Scrub the video to the card, then capture that frame for recognition.";
                return;
            }
            mediaMessage = "Preview ready. Recognition is optional, and nothing is added until you confirm.";
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or JSException)
        {
            if (generation != scanGeneration) return;
            previewDataUrl = null;
            videoUrl = null;
            mediaMessage = "Media could not be processed locally on this device. Try another file.";
        }
    }

    private async Task CaptureVideoFrame()
    {
        if (string.IsNullOrEmpty(videoUrl) || mediaBusy) return;
        var generation = scanGeneration;
        mediaBusy = true;
        try
        {
            var jpeg = await JS.InvokeAsync<string>("spellbookMedia.captureFrame", "card-video-preview");
            if (generation != scanGeneration) return;
            if (!jpeg.StartsWith("data:image/jpeg;base64,", StringComparison.Ordinal))
                throw new InvalidDataException("Video capture did not return a JPEG frame.");
            previewDataUrl = jpeg;
            candidateName = "";
            recognizedText = "";
            ClearVerificationState();
            mediaMessage = "Frame captured. Recognize the text or enter the card name manually.";
        }
        catch (Exception ex) when (ex is JSException or InvalidDataException)
        {
            if (generation != scanGeneration) return;
            mediaMessage = "Could not capture this frame. Pause the video and wait for the image to load.";
        }
        finally { mediaBusy = false; }
    }


    [JSInvokable]
    public Task OnVideoScanProgress(int generation, int current, int total)
    {
        if (generation != scanGeneration) return Task.CompletedTask;
        videoScanProgress = current; videoScanTotal = total;
        videoScanMessage = "Sampling frames and recognizing text locally.";
        return InvokeAsync(StateHasChanged);
    }

    private async Task ScanVideo()
    {
        if (string.IsNullOrEmpty(videoUrl) || mediaBusy || videoScanActive) return;
        var generation = scanGeneration;
        mediaBusy = true; videoScanActive = true; videoScanProgress = 0; videoScanTotal = 0;
        videoCandidates.Clear(); videoScanMessage = "Preparing on-device OCR. The first scan downloads OCR assets.";
        using var callback = DotNetObjectReference.Create(this);
        try
        {
            var result = await JS.InvokeAsync<System.Text.Json.JsonElement>("spellbookMedia.scanVideo", "card-video-preview", callback, generation);
            if (generation != scanGeneration) return;
            var frames = result.GetProperty("frames").EnumerateArray().Select(frame => new Spellbook.Services.VideoOcrFrame(
                frame.GetProperty("time").GetDouble(),
                frame.GetProperty("text").GetString() ?? "",
                frame.TryGetProperty("stackCountEstimate", out var estimate) && estimate.ValueKind == System.Text.Json.JsonValueKind.Number && estimate.TryGetInt32(out var count) ? count : null,
                frame.TryGetProperty("sampleIndex", out var sampleIndex) && sampleIndex.TryGetInt32(out var index) ? index : -1));
            videoCandidates = Spellbook.Services.VideoCardCandidateBuilder.Build(frames);
            videoScanMessage = result.GetProperty("cancelled").GetBoolean() ? "Scan cancelled; review the cards found so far." : $"Scan complete. Review {videoCandidates.Count} candidate(s).";
        }
        catch (JSException)
        {
            videoScanMessage = "Local video scanning failed. You can still capture a frame manually.";
        }
        finally
        {
            if (generation == scanGeneration) { videoScanActive = false; mediaBusy = false; }
        }
    }

    private async Task CancelVideoScan()
    {
        try { await JS.InvokeVoidAsync("spellbookMedia.cancelVideoScan"); }
        catch (JSException) { videoScanMessage = "Could not stop the scan; wait for the current frame to finish."; }
    }

    private async Task AddVideoCandidates()
    {
        if (selected is null || mediaBusy) return;
        foreach (var candidate in videoCandidates.Where(c => !string.IsNullOrWhiteSpace(c.Name) && c.Name.Trim().Length <= 200 && c.Quantity is >= 1 and <= 250))
        {
            var name = candidate.Name.Trim();
            var existing = selected.Cards.FirstOrDefault(c => string.Equals(c.Name, name, StringComparison.OrdinalIgnoreCase) && string.Equals(c.Section.Trim(), "Main", StringComparison.OrdinalIgnoreCase));
            if (existing is null) selected.Cards.Add(new DeckCard { Name = name, Quantity = candidate.Quantity });
            else existing.Quantity = Math.Min(250, existing.Quantity + candidate.Quantity);
        }
        await Persist();
        videoCandidates.Clear();
        mediaMessage = "Reviewed video cards were added to the deck.";
    }

    private async Task ReadPhoto()
    {
        if (previewDataUrl is null || mediaBusy) return;
        mediaBusy = true;
        var generation = scanGeneration;
        var photo = previewDataUrl;
        mediaMessage = "Reading card text locally. The first run may take a while while OCR assets download.";
        try
        {
            var text = await JS.InvokeAsync<string>("spellbookMedia.recognize", photo);
            if (generation != scanGeneration) return;
            // A new OCR result invalidates any earlier Scryfall verification for this photo.
            ClearVerificationState();
            recognizedText = text.Trim();
            // OCR can mistake card names for other printed text. Every candidate must be confirmed.
            candidateName = Spellbook.Services.CardTitleExtractor.FromOcr(recognizedText);
            mediaMessage = string.IsNullOrWhiteSpace(candidateName)
                ? "No readable card title found. Enter the card name yourself."
                : "Review and correct the proposed card name before adding it.";
        }
        catch (JSException)
        {
            if (generation != scanGeneration) return;
            mediaMessage = "On-device OCR is unavailable. You can still type the card name manually.";
        }
        finally
        {
            mediaBusy = false;
        }
    }

    private async Task ConfirmScannedCard()
    {
        if (selected is null || mediaBusy || string.IsNullOrWhiteSpace(previewDataUrl)) return;
        if (string.IsNullOrWhiteSpace(candidateName) || candidateName.Trim().Length > 200)
        {
            mediaMessage = "Enter a valid card name (1–200 characters) before adding.";
            return;
        }
        cardName = verifiedScan is not null && string.Equals(lastVerifiedName, candidateName.Trim(), StringComparison.Ordinal)
            ? verifiedScan.Name : candidateName.Trim();
        quantity = 1;
        await AddCard();
        mediaMessage = "Confirmed card added to the selected deck.";
        candidateName = "";
        recognizedText = "";
        verifiedScan = null;
        lastVerifiedName = null;
        verificationMessage = "";
    }

    private void ClearScan()
    {
        scanGeneration++;
        videoCandidates.Clear();
        videoScanMessage = "";
        if (videoScanActive) _ = JS.InvokeVoidAsync("spellbookMedia.cancelVideoScan");
        videoScanActive = false;
        mediaNames.Clear();
        previewDataUrl = null;
        if (videoUrl is not null) _ = JS.InvokeVoidAsync("spellbookMedia.releaseVideo");
        videoUrl = null;
        candidateName = "";
        recognizedText = "";
        verifiedScan = null;
        lastVerifiedName = null;
        verificationMessage = "";
        mediaMessage = "";
    }
}
