@inherits LayoutComponentBase

<div class="shell" @onkeydown="HandleShellKeyDown">
    <header class="shell-header">
        <a class="brand" href="/">✦ Spellbook <AppVersion /></a>
        <button class="navigation-toggle secondary" type="button"
                aria-controls="app-navigation" aria-expanded="@navigationOpen"
                @onclick="ToggleNavigation" @ref="navigationToggle">
            <span class="navigation-toggle-icon" aria-hidden="true">☰</span>
            <span>Menu</span>
        </button>
        <aside id="app-navigation" class="navigation-panel" aria-label="App sections"
              hidden="@(!navigationOpen)">
            <div class="navigation-panel-heading">
                <h2>Pages</h2>
                <button class="secondary" type="button" @onclick="CloseAndRestoreFocus">Close</button>
            </div>
            <nav aria-label="Main navigation">
                <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseNavigation">Decks</NavLink>
                <NavLink href="/settings" @onclick="CloseNavigation">Settings</NavLink>
            </nav>
        </aside>
    </header>

    <main>@Body</main>
    <footer>
        Prototype · Your decks stay in this browser until exported. No paid APIs.
        <FeedbackLink />
    </footer>
</div>

@code {
    private bool navigationOpen;
    private ElementReference navigationToggle;

    private void ToggleNavigation() => navigationOpen = !navigationOpen;

    private void CloseNavigation() => navigationOpen = false;

    private async Task CloseAndRestoreFocus()
    {
        navigationOpen = false;
        await navigationToggle.FocusAsync();
    }

    private async Task HandleShellKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape" && navigationOpen)
            await CloseAndRestoreFocus();
    }
}
