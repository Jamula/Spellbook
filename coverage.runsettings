<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <ModulePaths>
      <Include>
        <ModulePath>.*Spellbook\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <Sources>
      <Exclude>
        <Source>.*[/\\]obj[/\\].*</Source>
        <Source>.*[/\\]Program\.cs$</Source>
      </Exclude>
    </Sources>
  </CodeCoverage>
</Configuration>
